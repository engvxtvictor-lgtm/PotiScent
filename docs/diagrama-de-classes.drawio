        <mxCell id="p2c51" value="Cada subclasse de Perfume apenas repassa os&lt;br&gt;argumentos ao construtor da superclasse e define&lt;br&gt;a maceração mínima (dias) e a faixa de&lt;br&gt;concentração (valores após &amp;quot;→&amp;quot;)." style="shape=note;whiteSpace=wrap;html=1;size=12;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="340" height="74" as="geometry"/></mxCell>
        <mxCell id="p2c52" value="Não confirmado no código: relação entre Perfumista e&lt;br&gt;produção/produtos. Perfumista não é referenciado&lt;br&gt;por nenhuma classe fora do pacote pessoas; por isso&lt;br&gt;nenhuma associação foi desenhada." style="shape=note;whiteSpace=wrap;html=1;size=12;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="860" y="560" width="410" height="74" as="geometry"/></mxCell>
